# Database Connection
# Zero-setup local default:
DATABASE_URL="file:./dev.db"

# PostgreSQL production connection string example:
# DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/taskshift_db?schema=public"

# JWT Authentication Secret
JWT_SECRET="replace_with_a_strong_random_secret_string"

# Web Push Notifications (VAPID)
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY="YOUR_VAPID_PUBLIC_KEY"
VAPID_PRIVATE_KEY="YOUR_VAPID_PRIVATE_KEY"
VAPID_SUBJECT="mailto:admin@yourdomain.com"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

